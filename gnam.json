{
  "format": 1,
  "plugins": [
    "@gnam/lore",
    "@gnam/release",
    "@gnam/recall",
    "@gnam/layout",
    "@gnam/export"
  ],
  "export": {
    "targets": {
      "swift": {
        "path": "swift",
        "repo": "https://github.com/obov/gentizer-swift.git",
        "include": {
          "conformance": "Tests/Conformance",
          "LICENSE": "LICENSE"
        },
        "tag": "{version}",
        "version": "swift/VERSION"
      }
    }
  },
  "release": {
    "targets": {
      "packages/core": "semver",
      "packages/dom": "semver",
      "packages/a2ui": "semver",
      "packages/ag-ui": "semver",
      "packages/react": "semver",
      "packages/react-a2ui": "semver"
    }
  }
}
